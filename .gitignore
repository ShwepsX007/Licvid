# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv*/
env/
envs/

# node (тесты: npm install --no-save jsdom ws)
node_modules/
npm-debug.log*

# Рантайм-данные (срезы оборота для volAvg7d, база аккаунтов, история)
data/
*.tmp

# Логи и дампы — никогда в git
*.log
*.log.*
uvicorn*.out
server.out
nohup.out
bot.log*

# База SQLite на всякий случай (штатно живёт в data/, игнорируется и так)
*.db
*.db-journal
*.sqlite
*.sqlite3

# IDE / ОС — частые «утяжелители» папок перед загрузкой на git
.idea/
.vscode/
*.sublime-workspace
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# Локальные секреты (токены/почта — только в окружении systemd, не в git)
.env
.env.*
secrets*.json

# Рабочие данные сервера: шарды истории ликвидаций, часовые сводки, кэши
# уровней и история OI создаются на лету (в том числе тестами в корне
# репозитория) и в git не должны — их место на сервере, а не в коммите
liq_history*.jsonl
hours_*.json
levels.json
oi_history*.json
accounts.db
accounts.db-*
*.sqlite3
