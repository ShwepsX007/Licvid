[Unit]
Description=Licvid Liquidation Terminal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/Licvid
Environment=PYTHONUNBUFFERED=1
Environment=LIQSCOPE_SYMBOLS_LIMIT=40
Environment=LIQSCOPE_EXCHANGES=binance,bybit,okx,gate,bitget,htx,bitmex,hyperliquid
# Источник потиковых данных для графика. По умолчанию пробуется Binance,
# затем Bybit. Если Binance на этом сервере не отдаёт сделки — раскомментируйте:
# Environment=LIQSCOPE_TICK_SOURCE=bybit
# Демо-поток (синтетика) — только для проверки интерфейса:
# Environment=LIQSCOPE_DEMO=1
# Ликвидации Hyperliquid через индексатор 0xArchive (необязательно).
# Ключи берём на https://0xarchive.io — бесплатный тариф даёт 50 000 кредитов
# в месяц на аккаунт, поэтому ключей можно вписать несколько через запятую:
# бюджет сложится. Без ключей источник просто не стартует, остальное работает.
# Режим по умолчанию rest — живой WS-канал ликвидаций у 0xArchive пуст
# (замер 14.09.2026), поэтому берём их опросом раз в 120 с.
# Environment=LIQSCOPE_OXA_KEYS=0xa_ключ1,0xa_ключ2
# Environment=LIQSCOPE_OXA_COINS_PER_KEY=2
# Environment=LIQSCOPE_OXA_POLL_SEC=120
# Кабинет / бот / HTTPS (см. deploy/HTTPS.md):
Environment=LIQSCOPE_PUBLIC_URL=https://liqscope.online
Environment=LIQSCOPE_COOKIE_SECURE=1
# Токен бота, админы, почта и секрет — только в /etc/systemd/system/licvid.service
# (или drop-in), не в git:
# Environment=LIQSCOPE_BOT_TOKEN=
# Environment=LIQSCOPE_ADMIN_IDS=          # telegram id админов
# Environment=LIQSCOPE_ADMIN_EMAILS=       # админы, зарегистрированные по почте
# Environment=LIQSCOPE_SECRET=
# Почта — основной вход (подтверждение адреса, вход по ссылке, сброс пароля).
# Без SMTP регистрация работает, но письма не уходят: в логе будет
# «SMTP не настроен», а ссылку видно в /api/admin/overview → mail.last.
# Environment=LIQSCOPE_SMTP_HOST=smtp.yandex.ru
# Environment=LIQSCOPE_SMTP_PORT=465
# Environment=LIQSCOPE_SMTP_TLS=ssl
# Environment=LIQSCOPE_SMTP_USER=no-reply@liqscope.online
# Environment=LIQSCOPE_SMTP_PASSWORD=пароль-приложения
# Environment=LIQSCOPE_SMTP_FROM=LiqScope <no-reply@liqscope.online>
# Стенд без реального ящика: письма складываются в папку
# Environment=LIQSCOPE_MAIL_DIR=/tmp/liqscope-mail
#
# В Type=simple разрешена РОВНО одна строка ExecStart.
# Две сразу (например, venv и /usr/bin) →
# «Failed to restart: Unit licvid.service has a bad unit file setting».
# nginx слушает 80/443 и проксирует сюда — снаружи 8000 не открываем.
ExecStart=/root/Licvid/venv/bin/python3 -m uvicorn server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
